# Required directories for systems under test
BACKEND_DIR=../fantasy-curling-backend
FRONTEND_DIR=../fantasy-curling-frontend

# Frontend runtime values
FRONTEND_URL=http://localhost:5173
FRONTEND_START_COMMAND=npm run dev -- --mode devlocal
VITE_SUPABASE_URL=https://example.supabase.co
VITE_SUPABASE_ANON_KEY=replace-me
VITE_API_ENV=devlocal

# Backend runtime values
BACKEND_URL=http://localhost:3000
BACKEND_START_COMMAND=npm run start:dev
NODE_ENV=test
# Optional fallback when Docker/Testcontainers is unavailable:
# MONGO_URL=mongodb://localhost:27017

# Optional backend auth passthrough (only needed if CMS flows are tested)
CMS_AUTH=

# Keep this unset to force deterministic local JWT mode in backend
# SUPABASE_PROJECT_ID=

# Deterministic smoke credentials (must exist in seeded auth system)
E2E_USER_EMAIL=test@example.com
E2E_USER_PASSWORD=Password123!
